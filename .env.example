APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
IS_TESTING=false
APP_URL=http://localhost
APP_DISPLAY_TIMEZONE=Asia/Manila

IPLUMA_API_URL=
IPLUMA_API_KEY=
IPLUMA_APP_NAME=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

LEGACY_DB_CONNECTION=mysql
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
# ncip db name
LEGACY_DB_DATABASE=legacy_dots
# ncip db name
# LEGACY_DB_DATABASE=dots
LEGACY_DB_USERNAME=root
# LEGACY_DB_PASSWORD="NCIP#14jm"
LEGACY_DB_PASSWORD=
LEGACY_DB_CHARSET=utf8mb4
LEGACY_DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outlook / Microsoft 365 authenticated SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HRIS_API_URL=
HRIS_API_TOKEN=
HRIS_EMPLOYEE_PATH=/api/employees
HRIS_ROSTER_PATH=/api/employees
HRIS_OFFICE_PATH=/api/offices
# true: use tests/Fixtures/hris responses for employee and office lookups.
HRIS_USE_SAMPLE_DATA=false

# Login reCAPTCHA (set enabled=true after adding keys from Google reCAPTCHA Admin)
RECAPTCHA_ENABLED=false
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# RECAPTCHA_ENABLED=true
# RECAPTCHA_V3_SITE_KEY=
# RECAPTCHA_V3_SECRET_KEY=
# RECAPTCHA_V2_SITE_KEY=
# RECAPTCHA_V2_SECRET_KEY=
# RECAPTCHA_SCORE_THRESHOLD=0.5


# Shared browser renderer for document previews and attachments (auto-detected if blank).
DOCUMENT_PDF_BROWSER_BINARY=
DOCUMENT_PDF_NODE_BINARY=node
DOCUMENT_PDF_TIMEOUT=45
DOCUMENT_PDF_SANDBOX=true
# Windows: install chrome-headless-shell and set DOCUMENT_PDF_BROWSER_BINARY to its .exe path.
DOCUMENT_PDF_PREFER_HEADLESS_SHELL=true
# PUPPETEER_CACHE_DIR=
